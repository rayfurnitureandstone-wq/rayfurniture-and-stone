---
import Base from '../../layouts/Base.astro';
import GeoBlock from '../../components/GeoBlock.astro';
import Faq from '../../components/Faq.astro';
import { site, waLink } from '../../data/site.js';
import { kitchenCities, cityCopy } from '../../data/cities.js';

export function getStaticPaths() {
  return kitchenCities.map(c => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;

const materials = [
  ['Top Table Granit', 'Tahan panas, gores, dan noda — aman untuk dapur yang dipakai masak setiap hari.'],
  ['Top Table Marmer', 'Motif urat alami yang mewah. Perlu sealing rutin agar noda tidak meresap.'],
  ['Top Table Quadra', 'Permukaan solid tanpa pori, sangat tahan noda dan mudah dibersihkan.'],
  ['Top Table Sintered Stone', 'Material berteknologi tinggi, tahan panas dan gores ekstrem, tampilan presisi.'],
];

const desc = `Jasa pasang top table marmer, granit, quadra, dan sintered stone di ${c.nama}. Pengukuran presisi, pemotongan di workshop, edging rapi. Mulai Rp 700.000/m². Melayani ${c.landmark}.`;

const faqCity = [
  [`Berapa harga pasang top table marmer/granit di ${c.nama}?`, `Mulai Rp 700.000/m² untuk pemasangan. Angka final keluar setelah pengukuran di lokasi ${c.nama}, tergantung material, ketebalan, dan panjang top table.`],
  [`Apakah survei top table ke ${c.nama} dikenakan biaya?`, `Tidak. Survei dan pengukuran di ${c.nama} kami lakukan tanpa biaya, ${c.ongkir}.`],
  [`Berapa lama pengerjaan top table?`, `Top table standar 3–5 hari kerja, tergantung panjang dan jumlah potongan. ${c.effort}.`],
  [`Bisa pasang sekaligus kitchen set-nya di ${c.nama}?`, `Bisa. Kami juga membuat kitchen set custom — Anda bisa sekaligus pasang top table marmer/granit/quadra dalam satu jadwal.`],
];

const ld = {
  '@context': 'https://***',
  '@type': 'Service',
  serviceType: `Jasa Pasang Top Table Marmer, Granit, Quadra & Sintered Stone ${c.nama}`,
  provider: { '@type': 'FurnitureStore', name: site.name, url: site.origin },
  areaServed: { '@type': 'City', name: c.nama },
  offers: { '@type': 'Offer', priceCurrency: 'IDR', price: '700000', description: 'Harga mulai per m²' },
};

const breadcrumb = {
  '@context': 'https://***',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Top Table', item: site.origin + '/top-table/' },
    { '@type': 'ListItem', position: 3, name: c.nama, item: `${site.origin}/top-table/${c.slug}/` },
  ],
};
---

<Base title={`Jasa Pasang Top Table ${c.nama} — Marmer, Granit & Quadra`} description={desc}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <section class="sec">
    <div class="wrap">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8a9099;margin-bottom:10px">
        <a href="/">Home</a> › <a href="/top-table/">Top Table</a> › <span>{c.nama}</span>
      </nav>
      <h1 style="font-size:clamp(28px,4.4vw,46px);line-height:1.1;margin:0 0 14px">
        Jasa Pasang Top Table <em style="font-style:normal;color:var(--green)">{c.nama}</em>
      </h1>
      <p class="lead" style="max-width:70ch">
        Butuh pasang top table marmer, granit, quadra, atau sintered stone di {c.nama}? Kami
        melayani pengukuran presisi di {c.landmark}, pemotongan di workshop Cibubur, sampai
        pemasangan dan edging rapi. {c.ongkir}.
      </p>
      <p style="max-width:70ch;line-height:1.9">{(cityCopy(c)).unik}</p>
      <p style="margin-top:20px">
        <a class="btn btn--green" href={waLink(`Halo Kak, saya mau tanya jasa pasang top table marmer/granit di ${c.nama}.`)}>Tanya Pasang Top Table {c.nama} →</a>
      </p>
      <GeoBlock links={['/', '/kitchen-set/', '/top-table/']} />
    </div>
  </section>

  <section class="sec sec--cream">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Material</p>
        <h2 class="h-sec">Pilihan Top Table untuk Area {c.nama}</h2>
      </div>
      <div class="feat-grid feat-grid--2">
        {materials.map(([t, d]) => (
          <article class="feat"><h3>{t}</h3><p>{d}</p></article>
        ))}
      </div>
      <p style="margin-top:22px"><a class="link-more" href="/top-table/">Lihat hub top table lengkap →</a></p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Cakupan</p>
        <h2 class="h-sec">Wilayah Kerja di {c.nama}</h2>
      </div>
      <p style="line-height:1.9;max-width:70ch">
        Kami menangani pemasangan top table di {c.landmark}, untuk rumah baru, apartemen,
        renovasi dapur, maupun penggantian top table lama. {c.catatan}
      </p>
      <p style="margin-top:16px">Butuh kitchen set-nya juga? <a class="link-more" href={`/kitchen-set/${c.slug}/`}>Lihat Kitchen Set Custom {c.nama} →</a></p>
      <p style="margin-top:10px">Ingin lihat galeri 16 varian marmer &amp; granit plus harga paket lengkap? <a class="link-more" href="https://toptablecibubur.rayfurnitureandstone.id/">Kunjungi Top Table Cibubur →</a></p>
    </div>
  </section>

  <Faq items={faqCity} title={`Pertanyaan Seputar Top Table ${c.nama}`} />
</Base>
