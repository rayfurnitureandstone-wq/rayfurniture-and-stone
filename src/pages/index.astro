---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import GeoBlock from '../components/GeoBlock.astro';
import Faq from '../components/Faq.astro';
import PostCard from '../components/PostCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { getCollection } from 'astro:content';
import { services, inclusions, customVsStock, stoneRestoration, process, waLink, site } from '../data/site.js';


const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date)).slice(0, 6);
const desc = 'Selain produksi kitchen set dan furniture custom, Ray Furniture & Stone juga menyediakan jasa pasang marmer dan granit serta poles lantai. Desain 3D gratis, garansi 1 tahun.';
---

<Base title="Kitchen Set Custom — Fokus Utama Kami" description={desc}>
  <HeroSlider />
  <GeoBlock links={['/', '/about/', '/top-table/']} />

  <!-- Fokus utama: kitchen set -->
  <section class="sec" aria-labelledby="main-title">
    <div class="wrap two-col" style="align-items:center;gap:40px">
      <div>
        <p class="eyebrow">Kitchen Set Custom Bogor — Garansi 1 Tahun</p>
        <h1 id="main-title">Kitchen Set & Furniture Custom</h1>
        <p class="lead">Setiap kitchen set dibuat mengikuti ukuran ruang Anda. Bukan ready stock yang pas-pasan.</p>
        <p>Anda ingin desain ramping, rak banyak, atau laci penuh yang pas? Setiap modul kami potong sendiri di workshop, pakai HPL, marmer, granit, atau bahan pilihan. Sebelum produksi, kami kirimkan desain 3D gratis — baru di-setujui lanjut ke produksi.</p>
        <p style="margin-top:18px"><strong>Garansi 1 tahun</strong> untuk engsel, handle, HPL yang lengkung atau mengelupas, dan cacat produksi, dengan syarat dan ketentuan.</p>
        <p style="margin-top:16px"><a class="btn btn--green" href={waLink('Halo Kak, saya mau diskusi kitchen set custom untuk dapur saya.')}>Mulai Konsultasi Gratis →</a></p>
      </div>
      <div><img src="/images/mbr-1421x983.jpg" alt="Contoh hasil kitchen set custom Ray Furniture and Stone" width="800" height="560" style="border-radius:16px" loading="eager"></div>
    </div>
  </section>

  <!-- Dua layanan pendukung -->
  <section class="sec sec--cream" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Layanan pendukung</p>
        <h2 class="h-sec" id="svc-title">Pasang Marmer, Granit &amp; Quadra · Pasang &amp; Poles Lantai</h2>
        <p class="sub-sec">Selain produksi kitchen set dan furniture custom, kami juga menyediakan jasa pasang marmer, granit, dan quadra serta poles lantai.</p>
      </div>
      <div class="feat-grid">
        <article class="feat">
          <h3>Pasang Marmer, Granit &amp; Quadra</h3>
          <p style="color:var(--green);font-weight:700;margin-bottom:8px">Mulai Rp 700.000/m²</p>
          <p>Top table, lantai, dinding, atau backsplash. Diukur presisi di lokasi, dipotong di workshop, lalu dipasang pakai lem khusus batu. Cocok untuk dapur baru atau renovasi lantai.</p>
          <p><a class="link-more" href="/top-table/">Coba Kitchen Set Simulator →</a></p>
        </article>
        <article class="feat">
          <h3>Pasang &amp; Poles Lantai Marmer/Granit</h3>
          <p style="color:var(--green);font-weight:700;margin-bottom:8px">Mulai Rp 75.000/m²</p>
          <p>Kilau lantai kembali bersinar. Ada Shine Restoration (kilau pulih) dan Full Stone Restoration (perbaiki nat yang rusak). Garansi sampai QC + DP lunas; kuantitas besar atau order ulang dapat diskon.</p>
          <p><a class="link-more" href="/about/#harga">Cek harga restoration →</a></p>
        </article>
      </div>
    </div>
  </section>

  <!-- Garansi & harga -->
  <section class="sec" id="harga" aria-labelledby="garansi-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Garansi &amp; harga</p>
        <h2 class="h-sec" id="garansi-title">Garansi</h2>
        <p class="sub-sec">Kami jujur: pekerjaan marmer/granit dan poles lantai tidak ada garansi after-sales. Garansi tetap sampai Anda tanda-tangani QC dan DP lunas. Order ulang dapat diskon.</p>
      </div>
      <div class="trust-grid-wrap"><div class="guarantee-grid">
        {services.slice(1).map(s => (
          <article><b>{s.lead}</b><span>{s.garansi}</span></article>
        ))}
      </div></div>
    </div>
  </section>

  <!-- Yang sudah termasuk paket kitchen set -->
  <section class="sec" aria-labelledby="incl-title">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Termasuk</p><h2 class="h-sec" id="incl-title">Apa yang Anda Dapatkan Saat Order Kitchen Set?</h2></div>
      <ul class="chips">{inclusions.map(([n, d]) => <li><b>{n}</b><span>{d}</span></li>)}</ul>
    </div>
  </section>

  <!-- Apa beda dengan ready stock -->
  <TrustStrip />
  <section class="sec sec--cream" aria-labelledby="custom-title">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Custom</p><h2 class="h-sec" id="custom-title">Kenapa pilih custom, bukan ready stock?</h2></div>
      <div class="feat-grid">{customVsStock.map(([h, p]) => <article class="feat"><h3>{h}</h3><p>{p}</p></article>)}</div>
    </div>
  </section>

  <!-- Harga restoration -->
  <section class="sec" aria-labelledby="restore-title">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Lantai kusam?</p><h2 class="h-sec" id="restore-title">Bawa kembali kilau marmer dan granit</h2><p class="sub-sec">Harga di bawah titik awal. Angka final keluar setelah kami lihat kondisi lantai di lokasi.</p></div>
      <div class="feat-grid feat-grid--2">
        {stoneRestoration.map(s => (
          <article class="price-card">
            <span class="from">{s.from}</span>
            <h3 style="margin:0;font-size:18px">{s.name}</h3>
            <p style="margin:0;color:var(--muted)">{s.text}</p>
            <a class="btn btn--green" href={waLink(`Halo Kak, saya mau tanya ${s.name}.`)} style="margin-top:auto;justify-content:center">Tanya harga</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Artikel 6 terbaru -->
  <section class="sec sec--cream" aria-labelledby="news-title">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Inspirasi</p><h2 class="h-sec" id="news-title">Enam postingan terbaru</h2><p class="sub-sec">Panduan dari lapangan: memilih marmer, menjaga kilap, harga custom vs ready stock.</p></div>
      <div class="post-grid">{posts.map(p => <PostCard post={p} />)}</div>
      {posts.length < 6 && <p style="text-align:center;margin:26px 0 0">Artikel bertambah sesuai proyek. Cek lagi nanti.</p>}
      <p style="text-align:center;margin:26px 0 0"><a class="btn btn--ghost" href="/what-news/">Lihat semua artikel</a></p>
    </div>
  </section>

  <!-- FAQ + CTA -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Sering ditanya</p><h2 class="h-sec">Punya pertanyaan?</h2><p class="sub-sec">WhatsApp kami, dijawab hari ini juga.</p></div>
      <Faq />
      <div class="cta" style="margin-top:44px">
        <h2>Butuh kitchen set custom atau poles lantai?</h2>
        <p>Kirim ukuran ruang dan foto area. Kami balas dengan estimasi material, rencana desain 3D singkat, dan jadwal — tanpa biaya.</p>
        <div class="btns">
          <a class="btn" href={waLink('Halo Kak, saya mau konsultasi gratis. Size ruang: ...')}>Chat WhatsApp</a>
          <a class="btn btn--ghost" href="/contact/">Halaman Kontak</a>
        </div>
      </div>
    </div>
  </section>
</Base>
