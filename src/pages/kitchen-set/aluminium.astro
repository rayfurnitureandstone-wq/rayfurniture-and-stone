---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { waLink, site } from '../../data/site.js';

const desc = 'Cari kitchen set aluminium terdekat? Workshop kami di Gunung Putri, Kabupaten Bogor, survei dan pasang gratis ke Bogor, Cibubur, Depok, Jakarta, Tangerang, Bekasi. Full aluminium anti rayap mulai Rp2.700.000 per meter lari. Garansi rangka 1 tahun.';

// Banner resmi pemilik: flyer bahan aluminium single layer, harga 2,7jt/m, bonus lengkap.
const banner = { src: '/images/kitchen-aluminium/banner-flyer.jpg', w: 1254, h: 1254 };

// MODEL: contoh nyata dari pekerjaan kami, bukan gambar contoh dari internet.
const models = [
  { src: '/images/kitchen-aluminium/model-japandi.jpg', w: 1440, h: 1800,
    nama: 'Japandi',
    isi: 'Putih matte dipadu kayu hangat dan gagang knob kuningan. Kesan tenang dan rapi. Cocok untuk dapur yang menyatu dengan ruang makan.' },
  { src: '/images/kitchen-aluminium/model-minimalis.jpg', w: 1440, h: 1920,
    nama: 'Minimalis',
    isi: 'Kabinet hitam rata tanpa gagang, dipadu kayu terang di pulau dapur. Kontras tegas, mudah dibersihkan, dan tidak ada gagang yang menyangkut.' },
  { src: '/images/kitchen-aluminium/model-semi-klasik.jpg', w: 1440, h: 1920,
    nama: 'Semi Klasik',
    isi: 'Pintu panel putih glossy dengan sebagian kabinet kaca berkotak, gagang tarik stainless. Ada kesan mewah, tapi tetap modern dan tidak berat.' },
  { src: '/images/kitchen-aluminium/model-bronze-mirror.jpg', w: 1440, h: 1802,
    nama: 'Bronze Mirror',
    isi: 'Kabinet atas berpanel cermin bronze, kabinet bawah champagne glossy. Ruangan terasa lebih terang dan lebih tinggi.' },
];

// Pilihan lain yang tersedia (daftar resmi pemilik, ejaan apa adanya).
const finishing = ['Single layer', 'Double layer', 'Cat Duco', 'Glass tone', 'Bronze mirror', 'HPL'];
const handleOpt = ['Finger grooved', 'Aluminium', 'Knob'];
const aksenList = ['Tambour panel', 'Flexible fluted panel', 'Profil classic panel'];

// MOTIF ACP: lembar katalog ACP yang dipakai untuk panel kabinet.
const acp = [
  { src: '/images/kitchen-aluminium/acp-1.jpg', w: 1080, h: 1530,
    nama: 'Warna solid doff',
    isi: 'Signal Blue, French Grey, Pure White, Ivory, Cream White, Light Coffee, Brown Door, Chinese Red, Violet.' },
  { src: '/images/kitchen-aluminium/acp-2.jpg', w: 1080, h: 1530,
    nama: 'Kayu, marmer & mirror',
    isi: 'Kayu: White Maple, White Oak, Black Wallnut, Cherry Wood, Dark Teak, Mahogany Wood, Neo Wooden. Marmer: Porto, Black Marmer, White Marmer, Vermont Marble, Sesame White, Cherokee Marble. Mirror: Silver Mirror, Golden Mirror.' },
  { src: '/images/kitchen-aluminium/acp-3.jpg', w: 1080, h: 1530,
    nama: 'Glossy & metallic',
    isi: 'Mengkilap: Yellow, White, Orange, Ivory, Blue, Red, Black, Brown, Green, Pink. Metalik: Light Silver, Champagne Gold, Seaweed Silver, Cooper.' },
  { src: '/images/kitchen-aluminium/acp-4.jpg', w: 1080, h: 1530,
    nama: 'Spesifikasi bahan',
    isi: 'Tebal 3 mm, ukuran lembar 1220 x 2440 mm, tipe coating PE. Anti rayap, kokoh, anti karat, dan warna tahan lama.' },
];

// DETAIL PEKERJAAN: foto dari pekerjaan kami sendiri.
const details = [
  { src: '/images/kitchen-aluminium/detail-1.jpg', nama: 'Rak tarik dua tingkat',
    isi: 'Keranjang stainless yang bisa ditarik penuh. Panci dan wajan di bagian belakang tetap terjangkau tanpa membungkuk.' },
  { src: '/images/kitchen-aluminium/detail-6.jpg', nama: 'Rail double track & rak sendok',
    isi: 'Laci ditarik penuh sampai ujung, jadi tidak ada barang yang tersembunyi di belakang. Di dalamnya sudah ada sekat sendok.' },
  { src: '/images/kitchen-aluminium/detail-7.jpg', nama: 'Pintu atas hidrolik & rak piring',
    isi: 'Pintu terangkat pakai hidrolik, jadi kepala tidak terbentur. Di dalamnya rak piring stainless di atas wastafel.' },
  { src: '/images/kitchen-aluminium/detail-5.jpg', nama: 'Ventilasi kabinet & lampu LED',
    isi: 'Slot udara di pintu bawah supaya isi kabinet tidak pengap, ditambah lampu LED di bawah kabinet atas.' },
  { src: '/images/kitchen-aluminium/detail-3.jpg', nama: 'Kabinet tabung gas',
    isi: 'Tabung gas ditaruh di kabinet berbaki tarik, bawahnya terbuka jadi sirkulasi udara tetap ada. Aman dan tidak berantakan.' },
  { src: '/images/kitchen-aluminium/detail-4.jpg', nama: 'Lampu LED bawah kabinet',
    isi: 'Area kerja terang tanpa bayangan badan sendiri, jadi memotong bahan tidak gelap dan tidak salah ukur.' },
  { src: '/images/kitchen-aluminium/detail-2.jpg', nama: 'Pintu rata tanpa gagang menonjol',
    isi: 'Gagang pakai coakan, tidak ada yang menyangkut baju. Sela antar pintu dijaga seragam supaya tampilannya rapi dari jauh.' },
  { src: '/images/kitchen-aluminium/detail-8.jpg', nama: 'Pemeriksaan sebelum serah terima',
    isi: 'Setelah semua terpasang, kami cek kerapatan pintu, nyala lampu, dan aliran udara kabinet sebelum Anda melihat hasilnya.' },
];

// JSON-LD Service: supaya mesin AI (ChatGPT, Gemini, Perplexity) punya angka
// dan cakupan wilayah yang bisa dikutip saat ditanya "kitchen set aluminium terdekat".
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kitchen Set Aluminium Custom',
  serviceType: 'Pembuatan dan pemasangan kitchen set full aluminium',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Ray Furniture & Stone',
    telephone: '+6282121841119',
    url: 'https://rayfurnitureandstone.id/',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Jl. Transyogi No.60, Nagrak',
      addressLocality: 'Gunung Putri',
      addressRegion: 'Jawa Barat',
      postalCode: '16967',
      addressCountry: 'ID',
    },
  },
  areaServed: ['Bogor', 'Kabupaten Bogor', 'Kota Bogor', 'Cibubur', 'Sentul', 'Depok', 'Jakarta', 'Tangerang', 'Tangerang Selatan', 'Bekasi', 'Cikarang', 'Karawang', 'Bandung', 'Sukabumi', 'Purwakarta', 'Serang'],
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: '2700000',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '2700000',
      priceCurrency: 'IDR',
      unitText: 'per meter lari',
    },
  },
};

const faqItems = [
  ['Kabinet aluminium beda apa dengan plywood?', 'Kabinet plywood dengan finishing HPL lebih murah dan motif kayunya hangat, tapi di dapur yang lembap lama-lama bisa mengembang dan dimakan rayap. Rangka aluminium tidak bisa dimakan rayap, tidak menyerap air, dan tidak berubah bentuk. Untuk dapur dekat pesisir atau yang sering terpapar uap, aluminium lebih awet.'],
  ['Harga Rp2,7 juta per meter lari itu untuk apa saja?', 'Harga mulai Rp2.700.000 per meter lari untuk rangka aluminium, lebar standar 60 cm. Sudah termasuk jasa pemasangan dan bonus standar kami: rak sendok, aluminium handle, rak piring bawah, engsel slowmotion, lampu kabinet LED, rail double track, dan ventilasi kabinet.'],
  ['Apakah kabinet bawah dan kabinet atas dihitung terpisah?', 'Ya. Kabinet bawah dan kabinet atas dihitung terpisah, tergantung yang Anda pilih. Kabinet bawah full box harganya berbeda dengan kabinet atas. Setelah survei kami kirim gambar 3D dan rincian biaya, jadi Anda tahu persis angka tiap bagian sebelum produksi mulai.'],
  ['Model dan motif bisa saya pilih sendiri?', 'Bisa. Model Japandi, Minimalis, Semi Klasik, dan Bronze Mirror yang tampil di halaman ini semuanya pernah kami kerjakan. Motif panel bisa diambil dari pilihan ACP, ada motif kayu, marmer, mirror, glossy, dan metalik. Saat survei kami bawa contoh bahannya supaya Anda bisa melihat dan meraba langsung, bukan cuma dari layar.'],
  ['Berapa lama pengerjaan?', 'Rata-rata 10 sampai 21 hari kerja, tergantung ukuran dan tingkat kerumitan, dihitung setelah desain 3D Anda setujui.'],
  ['Garansi rangka 1 tahun berlaku untuk apa?', 'Garansi 1 tahun untuk engsel, handle, lampu LED, dan HPL yang melengkung atau mengelupas. Khusus cacat produksi, dengan syarat dan ketentuan yang berlaku.'],
  ['Bagaimana kalau dapur saya bentuknya tidak beraturan?', 'Justru itu alasan memilih custom. Kami ukur dulu di lokasi, termasuk dinding yang tidak lurus dan sudut mati, lalu setiap modul dipotong mengikuti kondisi ruang Anda. Tidak ada sela kosong yang jadi tempat kotoran menumpuk.'],
  ['Di mana kitchen set aluminium terdekat yang bisa survei gratis?', 'Workshop kami ada di Jl. Transyogi No.60, Nagrak, Gunung Putri, Kabupaten Bogor, jalur yang sama kalau Anda dari Cibubur ke arah Sentul. Survei dan pengukuran gratis untuk seluruh Jabodetabek: Bogor, Cibubur, Sentul, Depok, Jakarta, Tangerang, dan Bekasi. Tunggu di rumah saja, tim kami yang datang membawa contoh bahan.'],
  ['Rumah saya di luar Jabodetabek, masih bisa pesan kitchen set aluminium?', 'Bisa. Selain seluruh Jabodetabek, kami juga melayani Bandung, Sukabumi, Purwakarta, dan Karawang. Cek dulu halaman kota untuk area Anda di daftar di bawah, atau langsung kirim ukuran lewat [WhatsApp kami](https://wa.me/6282121841119?text=Halo%20Kak%2C%20saya%20di%20luar%20Jabodetabek%2C%20mau%20tanya%20kitchen%20set%20full%20aluminium%20bisa%20dikerjakan%20nggak%3F).'],
  ['Cara memastikan yang memasang tim sendiri dan bukan subcontractor?', 'Salah satu tanda penyedia yang jujur: workshop-nya bisa didatangkan. Workshop kami di Gunung Putri, Kabupaten Bogor, dan Anda boleh mampir lihat proses potong dan rakit kabinet sebelum deal. Setelah pemasangan juga QC kami lakukan sendiri sampai Anda setuju, bukan dilempar ke pihak lain.'],
];
---

<Base title="Kitchen Set Aluminium Terdekat: Harga, Model & Jangkauan Jabodetabek" description={desc}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- ===== HERO ===== -->
  <section class="ka-hero">
    <div class="wrap ka-hero__in">
      <div class="ka-hero__copy">
        <p class="ka-eyebrow">Kitchen set aluminium terdekat &middot; Survei gratis Jabodetabek &middot; Garansi rangka 1 tahun</p>
        <h1>Kabinet Dapur Anda Sedang <span>Dimakan Pelan-pelan</span>, dan Tidak Terasa Sampai Terlambat</h1>
        <p class="ka-lead">Uap dari kompor menempel di kabinet setiap hari. Tiga tahun pertama tidak ada tanda apa pun. Lalu pintu mulai tidak rapat, engsel turun, dan ketika Anda menarik laci, yang keluar bukan piring, tapi bubuk kayu.</p>
        <p class="ka-lead ka-lead--mute">Perbaikannya bukan ditambal. Rangkanya yang diganti ke aluminium, dan masalah itu selesai sejak hari pertama dipasang.</p>
        <p class="ka-btn-row">
          <a class="btn btn--wa" href={waLink('Halo Kak, saya mau tanya kitchen set full aluminium. Boleh minta survei gratis dan lihat contoh motifnya?')}>Minta Survei Gratis Sekarang &rarr;</a>
        </p>
        <p class="ka-note">Balas hari ini. Survei lokasi, desain 3D, dan rincian biaya tidak dipungut biaya di Jabodetabek.</p>
      </div>
      <div class="ka-hero__media">
        <img src={banner.src} width={banner.w} height={banner.h}
             alt="Banner kitchen set aluminium single layer Ray Furniture & Stone, harga mulai 2,7 juta per meter, bonus LED strip, rel slowmotion, rak, engsel slowmotion, dan handle"
             loading="eager" />
      </div>
    </div>
  </section>

  <!-- ===== AGITATE ===== -->
  <section class="sec sec--cream" aria-labelledby="ka-agit">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Yang terjadi tiap hari</p>
        <h2 class="h-sec" id="ka-agit">Dapur Jadi Ruangan yang Paling Malas Anda Masuki</h2>
        <p class="sub-sec">Bukan karena Anda tidak rajin. Kabinet yang sudah rusak diam-diam membuat pekerjaan paling sederhana jadi berat.</p>
      </div>
      <div class="ka-pain">
        <article class="ka-pain__item">
          <p class="ka-pain__no">01</p>
          <h3>Pintu tidak bisa rapat lagi</h3>
          <p>Kayu yang mengembang membuat pintu bergeser dan tidak menutup sempurna. Semut jadi mudah masuk, dan isi kabinet berdebu.</p>
        </article>
        <article class="ka-pain__item">
          <p class="ka-pain__no">02</p>
          <h3>Bau apek yang tidak hilang</h3>
          <p>Kabinet kayu yang menyerap uap jadi tempat bakteri. Bahan makanan disimpan di sebelahnya, dan baunya menempel ke beras serta bumbu.</p>
        </article>
        <article class="ka-pain__item">
          <p class="ka-pain__no">03</p>
          <h3>Biaya besar yang datang tiba-tiba</h3>
          <p>Rayap dan lapuk baru ketahuan setelah parah. Ganti satu set kabinet bukan perbaikan kecil, dan itu pengeluaran puluhan juta yang tidak pernah Anda rencanakan.</p>
        </article>
      </div>
      <p class="ka-pivot">Aluminium memotong seluruh rangkaian masalah itu. Bukan karena lebih mahal, tapi karena bahannya memang tidak bisa dimakan rayap dan tidak bisa lapuk.</p>
    </div>
  </section>

  <!-- ===== SOLUSI ===== -->
  <section class="sec" aria-labelledby="ka-sol">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Solusinya</p>
        <h2 class="h-sec" id="ka-sol">Rangka Aluminium, Fungsinya Sama, Umurnya Beda</h2>
        <p class="sub-sec">Bentuk dan fungsinya sama seperti kabinet biasa. Yang berubah hanya rangkanya: aluminium, bukan kayu. Air tidak menyerap, rayap tidak makan, dan pintunya tetap presisi bertahun-tahun.</p>
      </div>
      <div class="ka-feat">
        <article class="ka-feat__item">
          <h3>Tidak bisa dimakan rayap</h3>
          <p>Rayap butuh selulosa, dan aluminium tidak punya. Tidak ada bubuk kayu, tidak ada sarang tersembunyi di balik kabinet.</p>
        </article>
        <article class="ka-feat__item">
          <h3>Tidak menyerap air</h3>
          <p>Uap dapur yang menempel setiap hari tidak membuat rangka mengembang atau berubah bentuk. Laci tetap lurus, pintu tetap rapat.</p>
        </article>
        <article class="ka-feat__item">
          <h3>Ukur dulu, baru dipotong</h3>
          <p>Kami ukur dapur Anda di lokasi, termasuk dinding yang tidak lurus dan sudut mati. Anda menerima gambar 3D dan rincian biaya sebelum produksi jalan.</p>
        </article>
        <article class="ka-feat__item">
          <h3>Tidak ada tambahan di tengah jalan</h3>
          <p>Angka yang Anda setujui di rincian biaya itu yang berlaku. Kabinet bawah dan atas dihitung terbuka, jadi Anda tahu bayar untuk bagian apa.</p>
        </article>
        <article class="ka-feat__item">
          <h3>Bonus standar ikut semua</h3>
          <p>Rak sendok, aluminium handle, rak piring bawah, engsel slowmotion, lampu kabinet LED, rail double track, dan ventilasi kabinet. Bukan tambahan berbayar.</p>
        </article>
        <article class="ka-feat__item">
          <h3>Garansi rangka 1 tahun</h3>
          <p>Untuk engsel, handle, lampu LED, dan HPL yang melengkung atau mengelupas. Khusus cacat produksi, dengan syarat dan ketentuan.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== MODEL & AKSEN ===== -->
  <section class="sec sec--cream" id="model" aria-labelledby="ka-model">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Pilih modelnya</p>
        <h2 class="h-sec" id="ka-model">Empat Model yang Bisa Anda Pilih</h2>
        <p class="sub-sec">Ini contoh nyata dari pekerjaan kami, bukan gambar contoh dari internet. Saat survei kami bawa contoh bahan, jadi Anda bisa melihat dan meraba langsung sebelum memutuskan.</p>
      </div>
      <div class="ka-model">
        {models.map(m => (
          <figure class="ka-model__item">
            <img src={m.src} width={m.w} height={m.h} alt={`Kitchen set aluminium model ${m.nama}`} loading="lazy" />
            <figcaption>
              <b>{m.nama}</b>
              <span>{m.isi}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="ka-opt">
        <div class="ka-opt__col">
          <h3>Finishing kabinet</h3>
          <ul class="ka-chips">{finishing.map(f => <li>{f}</li>)}</ul>
        </div>
        <div class="ka-opt__col">
          <h3>Pilihan handle</h3>
          <ul class="ka-chips">{handleOpt.map(f => <li>{f}</li>)}</ul>
        </div>
        <div class="ka-opt__col">
          <h3>Aksen tambahan</h3>
          <ul class="ka-chips">{aksenList.map(f => <li>{f}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MOTIF ACP ===== -->
  <section class="sec" id="motif" aria-labelledby="ka-motif">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Pilih motifnya</p>
        <h2 class="h-sec" id="ka-motif">Motif ACP untuk Panel Kabinet</h2>
        <p class="sub-sec">Kalau Anda ingin tampilan kayu, marmer, atau cermin tanpa risiko lapuk, panelnya bisa memakai ACP. Motifnya jadi, tidak perlu dicat ulang, dan tahan air. Ini lembar pilihan yang kami bawa saat survei.</p>
      </div>
      <p class="ka-hint">Teks nama warna di lembar ini kecil. Klik gambarnya untuk membuka ukuran penuh.</p>
      <div class="ka-acp">
        {acp.map(a => (
          <figure class="ka-acp__item">
            <a class="ka-acp__zoom" href={a.src} target="_blank" rel="noopener" aria-label={`Buka lembar motif ACP ukuran penuh: ${a.nama}`}>
              <img src={a.src} width={a.w} height={a.h} alt={`Lembar pilihan motif ACP: ${a.nama}`} loading="lazy" />
            </a>
            <figcaption>
              <b>{a.nama}</b>
              <span>{a.isi}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="ka-disclaim">Catatan jujur: warna di layar bisa berbeda dengan bahan aslinya, terutama warna metalik dan mirror karena pantulan cahaya. Karena itu kami selalu membawa contoh fisik ke lokasi saat survei, supaya motif yang Anda pilih memang motif yang dipasang.</p>
    </div>
  </section>

  <!-- ===== DETAIL PEKERJAAN ===== -->
  <section class="sec sec--cream" id="detail" aria-labelledby="ka-detail">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Detail pekerjaan kami</p>
        <h2 class="h-sec" id="ka-detail">Yang Membedakan Terlihat dari Bagian yang Jarang Difoto</h2>
        <p class="sub-sec">Pintu depan semua kitchen set kelihatan mirip. Yang menentukan awet atau tidak justru engsel, rel, ventilasi, dan kerapatan sela antar pintu. Ini foto dari pekerjaan kami sendiri.</p>
      </div>
      <div class="ka-detail">
        {details.map(d => (
          <figure class="ka-detail__item">
            <img src={d.src} width={480} height={640} alt={`Detail pekerjaan kitchen set aluminium: ${d.nama}`} loading="lazy" />
            <figcaption>
              <b>{d.nama}</b>
              <span>{d.isi}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HARGA ===== -->
  <section class="sec" id="harga" aria-labelledby="ka-harga">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Harga terbuka</p>
        <h2 class="h-sec" id="ka-harga">Berapa yang Anda Bayar</h2>
      </div>
      <div class="ka-price">
        <p class="ka-price__from">Kitchen set full aluminium</p>
        <p class="ka-price__amt">Rp 2.700.000<span>/meter lari</span></p>
        <p class="ka-price__note">Lebar standar 60 cm. Kabinet bawah dan kabinet atas dihitung terpisah, tergantung yang Anda pilih. Angka final keluar setelah ukur di lokasi, tanpa biaya.</p>
        <ul class="ka-price__inc">
          <li>Jasa pemasangan</li>
          <li>Rak sendok</li>
          <li>Aluminium handle</li>
          <li>Rak piring bawah</li>
          <li>Engsel slowmotion</li>
          <li>Lampu kabinet LED</li>
          <li>Rail double track</li>
          <li>Ventilasi kabinet</li>
        </ul>
        <a class="btn btn--wa" href={waLink('Halo Kak, saya mau minta rincian biaya kitchen set full aluminium untuk dapur saya.')}>Minta Rincian Biaya Dapur Saya</a>
        <p class="ka-price__fine">Garansi rangka 1 tahun untuk engsel, handle, lampu LED, dan HPL yang melengkung atau mengelupas. Khusus cacat produksi, syarat dan ketentuan berlaku.</p>
      </div>
    </div>
  </section>

  <!-- ===== JANGKAUAN / TERDEKAT ===== -->
  <section class="sec sec--cream" id="terdekat" aria-labelledby="ka-lokasi">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Kitchen set aluminium terdekat</p>
        <h2 class="h-sec" id="ka-lokasi">Workshop Kami di Gunung Putri, Tim Kami yang Datang ke Rumah Anda</h2>
        <p class="sub-sec">Bukan calo yang melempar proyek ke tukang antah berantah. Kami buat di workshop sendiri di Jl. Transyogi No.60, Nagrak, Gunung Putri, Kabupaten Bogor, lalu pasang sendiri sampai Anda tanda-tangani QC. Full aluminium mulai Rp2.700.000 per meter lari, kabinet bawah dan atas dihitung terpisah sesuai pilihan Anda. Mau bandingkan dulu? Kitchen set custom rangka plywood finishing HPL mulai Rp1.800.000 per meter lari. Survei dan pengukuran gratis untuk seluruh Jabodetabek.</p>
      </div>
      <ul class="ka-cities">
        <li><a href="/kitchen-set/cibubur/">Kitchen set aluminium Cibubur</a></li>
        <li><a href="/kitchen-set/bogor/">Kitchen set aluminium Bogor</a></li>
        <li><a href="/kitchen-set/sentul/">Kitchen set aluminium Sentul</a></li>
        <li><a href="/kitchen-set/depok/">Kitchen set aluminium Depok</a></li>
        <li><a href="/kitchen-set/jakarta-timur/">Kitchen set aluminium Jakarta Timur</a></li>
        <li><a href="/kitchen-set/jakarta-selatan/">Kitchen set aluminium Jakarta Selatan</a></li>
