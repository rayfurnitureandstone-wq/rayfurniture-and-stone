---
import Base from '../../layouts/Base.astro';
import GeoBlock from '../../components/GeoBlock.astro';
import Faq from '../../components/Faq.astro';
import { site, waLink, inclusions } from '../../data/site.js';
import { kitchenCities, cityCopy } from '../../data/cities.js';

export function getStaticPaths() {
  return kitchenCities.map(c => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const cp = cityCopy(c);

const faqCity = [
  [`Berapa harga kitchen set custom di ${c.nama}?`, `Mulai Rp 1.800.000 per meter lari (lebar standar 60 cm), sudah termasuk jasa pasang dan bonus standar. Angka final keluar setelah survei ukuran ruang di ${c.nama}. ${c.ongkir}.`],
  [`Apakah survei ke ${c.nama} dikenakan biaya?`, `Tidak. Survei dan pengukuran di ${c.namaPanjang} kami lakukan tanpa biaya, ${c.ongkir}.`],
  [`Berapa lama pengerjaan kitchen set untuk area ${c.nama}?`, `Rata-rata 10–21 hari kerja setelah desain 3D disetujui. ${c.catatan}`],
  [`Material apa yang tersedia untuk kitchen set ${c.nama}?`, `HPL motif kayu/marmer, aluminium (anti rayap, cocok untuk dapur lembap), serta top table marmer, granit, dan quadra. Pilihan bisa disesuaikan dengan anggaran Anda.`],
];

const ld = {
  '@context': 'https://***',
  '@type': 'Service',
  serviceType: `Jasa Kitchen Set Custom ${c.nama}`,
  provider: { '@type': 'FurnitureStore', name: site.name, url: site.origin },
  areaServed: { '@type': 'City', name: c.nama },
  offers: { '@type': 'Offer', priceCurrency: 'IDR', price: '1800000', description: 'Harga mulai per meter lari' },
};

const breadcrumb = {
  '@context': 'https://***',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Kitchen Set', item: site.origin + '/kitchen-set/' },
    { '@type': 'ListItem', position: 3, name: c.nama, item: `${site.origin}/kitchen-set/${c.slug}/` },
  ],
};
---

<Base title={cp.title} description={cp.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <section class="sec">
    <div class="wrap">
      <nav aria-label="Breadcrumb" style="font-size:13px;color:#8a9099;margin-bottom:10px">
        <a href="/">Home</a> › <a href="/kitchen-set/">Kitchen Set</a> › <span>{c.nama}</span>
      </nav>
      <h1 style="font-size:clamp(28px,4.4vw,46px);line-height:1.1;margin:0 0 14px">
        Jasa Kitchen Set Custom <em style="font-style:normal;color:var(--green)">{c.nama}</em>
      </h1>
      <p class="lead" style="max-width:70ch">{cp.intro}</p>
      <p style="max-width:70ch;line-height:1.9">{cp.unik}</p>
      <p style="margin-top:20px">
        <a class="btn btn--green" href={waLink(`Halo Kak, saya mau tanya kitchen set custom di ${c.nama}.`)}>Tanya Harga Kitchen Set {c.nama} →</a>
      </p>
      <GeoBlock links={['/', '/kitchen-set/', '/top-table/']} />
    </div>
  </section>

  <section class="sec sec--cream">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Kenapa Ray Furniture &amp; Stone</p>
        <h2 class="h-sec">Layanan Kitchen Set di {c.namaPanjang}</h2>
      </div>
      <ul style="line-height:2;max-width:70ch">
        {cp.lokal.map(t => <li>{t}</li>)}
      </ul>
      <p style="margin-top:18px"><strong>Area yang kami jangkau:</strong> {c.landmark}.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Yang Anda Dapatkan</p>
        <h2 class="h-sec">Bonus Standar Setiap Order Kitchen Set</h2>
      </div>
      <div class="feat-grid feat-grid--2">
        {inclusions.map(([t, d]) => (
          <article class="feat"><h3>{t}</h3><p>{d}</p></article>
        ))}
      </div>
      <p style="margin-top:22px">
        <a class="link-more" href="/kitchen-set/">Lihat hub kitchen set &amp; harga lengkap →</a>
      </p>
    </div>
  </section>

  <Faq items={faqCity} title={`Pertanyaan Seputar Kitchen Set ${c.nama}`} />
</Base>
